# ============================================================
#  متغيّرات الإنتاج — انسخ هذا الملف إلى .env ثم عدّل القيم
#      cp .env.production.example .env
#  ملاحظة: هذا الملف لِـ Docker Compose (في جذر المشروع).
#  للتطوير المحلّي بدون Docker استخدم backend/.env بدلاً منه.
# ============================================================

# ------- الأساسيات -------
# ولّد مفتاحاً سرياً قوياً (٥٠+ حرفاً) بالأمر:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=ضع-هنا-مفتاحاً-عشوائياً-طويلاً-جداً

# يجب أن تكون False في الإنتاج
DEBUG=False

# نطاقات موقعك مفصولة بفواصل (بدون http://)
ALLOWED_HOSTS=example.com,www.example.com

# نطاقاتك الكاملة لطلبات POST الآمنة (لوحة الأدمن) — مع https://
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# رابط الموقع (يُستخدم في روابط رسائل البريد)
SITE_URL=https://example.com
SITE_NAME=جمعية الأشعة

# ------- قاعدة البيانات (PostgreSQL) -------
USE_SQLITE=False
DB_NAME=csr_db
DB_USER=csr_user
# كلمة مرور قوية لقاعدة البيانات (إلزامية)
DB_PASSWORD=ضع-كلمة-مرور-قوية-هنا

# ------- منفذ الويب المكشوف -------
# 80 لـ HTTP. عند تفعيل HTTPS استخدم مُنهي TLS (انظر دليل النشر).
HTTP_PORT=80

# ------- أمان HTTPS (فعّلها بعد تجهيز شهادة TLS فقط) -------
# قبل توفّر HTTPS اترك SECURE_SSL_REDIRECT=False حتى لا يُقفل الموقع.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# بعد التأكد من عمل HTTPS: اجعلها 31536000 (سنة)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------- البريد الإلكتروني (SMTP) -------
# EMAIL_ENABLED=True يفعّل الإرسال الفعلي. False يطبع الرسائل في السجلّات فقط.
EMAIL_ENABLED=True
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=جمعية الأشعة <no-reply@example.com>

# ------- حساب المدير الأولي (يُنشأ تلقائياً عند أول تشغيل) -------
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ضع-كلمة-مرور-قوية-للمدير
DJANGO_SUPERUSER_FULL_NAME=مدير النظام

# ------- ضبط اختياري -------
# مدّة صلاحية رابط تنزيل وثيقة الاعتماد (ثوانٍ) — افتراضياً ساعة
CREDENTIAL_URL_MAX_AGE=3600
# حدود تسجيل الدخول/التسجيل
THROTTLE_LOGIN=5/min
THROTTLE_REGISTER=10/hour
# عدد عمّال Gunicorn (افتراضياً حسب المعالجات)
# GUNICORN_WORKERS=3
LOG_LEVEL=INFO
