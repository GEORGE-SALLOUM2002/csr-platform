# ============================================================
#  إعدادات البيئة لنشر جمعية الأشعة على PythonAnywhere (مجاني)
#  انسخ هذا الملف إلى backend/.env ثم عدّل القيم المعلّمة بـ CHANGE
#      cp backend/.env.pythonanywhere.example backend/.env
# ============================================================

# مفتاح Django السرّي — إلزامي وطويل (٣٢+ حرفاً).
# ولّد مفتاحاً خاصاً بك بهذا الأمر ثم ضعه هنا:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_ضع_مفتاحاً_عشوائياً_طويلاً_هنا

# يجب أن تبقى False في الإنتاج
DEBUG=False

# استبدل USERNAME باسم مستخدمك في PythonAnywhere
ALLOWED_HOSTS=USERNAME.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://USERNAME.pythonanywhere.com

# قاعدة بيانات SQLite (مناسبة للتجربة، وتبقى محفوظة على قرص PythonAnywhere الدائم)
USE_SQLITE=True

# البريد معطّل: تُطبَع الإشعارات في السجل (كافٍ للتجربة).
# الحساب المجاني في PythonAnywhere يقيّد الاتصالات الخارجية، لذا يبقى SMTP معطّلاً.
EMAIL_ENABLED=False

# اسم الموقع ورابطه (يظهران في نصوص الإشعارات)
SITE_NAME=جمعية الأشعة
SITE_URL=https://USERNAME.pythonanywhere.com

# إعادة التوجيه إلى HTTPS: فعّل بدلاً منها زر "Force HTTPS" من تبويب Web،
# فتبقى هذه False لتجنّب أي حلقة إعادة توجيه.
SECURE_SSL_REDIRECT=False
