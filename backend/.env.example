# ============================================================
#  انسخ هذا الملف إلى .env  ثم عدّل القيم حسب جهازك
#  Copy this file to .env then adjust the values
# ============================================================

# مفتاح سري للتطبيق (غيّره في الإنتاج) / Django secret key
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# وضع التطوير (True) أو الإنتاج (False) / Debug mode
DEBUG=True

# النطاقات المسموح بها / Allowed hosts (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# ------- قاعدة البيانات PostgreSQL -------
# اترك USE_SQLITE=False لاستخدام PostgreSQL (الموصى به)
# اجعلها True لتجربة سريعة عبر SQLite بدون تثبيت قاعدة بيانات
USE_SQLITE=False

DB_NAME=csr_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ------- عنوان الواجهة الأمامية (CORS) -------
# رابط تطبيق React أثناء التطوير / React dev server URL
FRONTEND_URL=http://localhost:5173

# ============================================================
#  البريد الإلكتروني (Gmail SMTP) — إعادة تعيين كلمة المرور والإشعارات
# ============================================================
# True = إرسال فعلي.  False = طباعة الرسالة في الطرفية (للتجربة بدون SMTP).
EMAIL_ENABLED=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-address@gmail.com
# كلمة مرور تطبيق (App Password) من Google — 16 حرفاً بدون مسافات
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=جمعية الأشعة <your-address@gmail.com>
# رابط الموقع المستخدم داخل رابط إعادة التعيين
SITE_URL=http://localhost:5173
SITE_NAME=جمعية الأشعة
THROTTLE_PASSWORD_RESET=5/hour
